# Autonomous Customer Resolution Agent — Environment Configuration Template

# === Groq AI Agent (Server-Side Only) ===
# Obtain an API key from https://console.groq.com
# This is ONLY read on the server by Next.js Route Handlers. Never exposed to browser.
GROQ_API_KEY=
# Groq model with tool-calling capabilities (defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# === Database (Optional for Production Persistence) ===
# For production deployment, set up a Supabase (or Neon) PostgreSQL database.
# When empty, the app uses in-memory simulated enterprise state.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# === External Agent Integration (Optional) ===
# URL of an external AI agent orchestration service if not using Groq.
NEXT_PUBLIC_AGENT_API_URL=

# === App Configuration ===
NODE_ENV=development
