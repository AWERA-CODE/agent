# Autonomous Customer Resolution Agent

# === Database ===
# For production deployment, set up a Supabase (or Neon/PlanetScale) PostgreSQL database
# and provide the connection string. When empty, the app uses in-memory simulated data.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# === Agent Integration ===
# URL of the AI agent orchestration service (provided by your teammate).
# When empty, the app uses mock agent mode with simulated traces.
NEXT_PUBLIC_AGENT_API_URL=

# === App Configuration ===
# Set to "production" for deployment, "development" for local dev
NODE_ENV=development

# Base URL of this application (auto-detected on Vercel, set manually otherwise)
# NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
